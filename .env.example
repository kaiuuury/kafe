# Copie para .env; Node só lê este arquivo com --env-file=.env.
HOST=127.0.0.1
PORT=4177
# Origem HTTPS exata após criar o serviço (sem barra final).
KAFE_PUBLIC_ORIGIN=
# URLs do SEU serviço TURN, separadas por vírgula (turn: e/ou turns:).
KAFE_TURN_URLS=
# Segredo compartilhado do coturn/TURN REST, nunca uma chave administrativa de API.
# Mínimo 32 caracteres. Configurar no servidor TURN e no backend Kafé.
KAFE_TURN_SECRET=
KAFE_TURN_TTL=3600
# Em publicação, use true para impedir iniciar sem TURN configurado.
KAFE_REQUIRE_TURN=false
